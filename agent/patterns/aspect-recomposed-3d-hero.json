{
  "schemaVersion": 1,
  "id": "aspect-recomposed-3d-hero",
  "pattern": {
    "id": "aspect-recomposed-3d-hero",
    "title": "三维主角随画幅重新构图",
    "category": "视觉构成",
    "experienceTypes": [
      "visual"
    ],
    "summary": "按容器画幅重排同一三维主角，为横竖屏标题保留清楚的阅读空间。",
    "mechanism": "读取首屏容器宽高比，以五档位置和等比缩放重新安排同一星球，并同步大气层，使主角与左下标题保持空间关系。",
    "trigger": "首次布局及首屏容器尺寸改变",
    "effect": "横屏星球偏右，竖屏星球缩小并上移，标题保持独立留白。",
    "useCases": [
      "以实时三维对象作为主角的品牌首屏",
      "需要同时适配横屏与竖屏的沉浸式展览首页"
    ],
    "avoid": [
      "把固定模型坐标直接用于所有画幅，遮挡标题或行动入口",
      "不核对模型轮廓就照搬来源缩放与位置"
    ],
    "constraints": [
      "阈值依据首屏容器宽高比，不是视口宽度；位置值是三维场景坐标，缩放相对来源模型，迁移时需按目标模型与相机重新核对。",
      "星球与大气层必须同步重新构图，标题和操作控件保持独立的语义内容层。",
      "来源未实现用户暂停；减少动态时跳过对象旋转，但仍更新着色器时间并渲染，不能将其描述为完整静态模式。"
    ],
    "composition": {
      "role": "foundation",
      "notes": "负责首屏三维主角与文字的空间分配；文字网格继续管理标题与行动的对齐，可见性机制另行决定场景是否渲染，不能用构图断点代替运行状态。",
      "pairsWellWith": [
        "editorial-alignment-grid",
        "viewport-animation-lifecycle"
      ],
      "conflicts": []
    },
    "accessibility": {
      "keyboard": "将标题、说明与行动保留为可顺序读取的语义内容，装饰性画布不进入键盘焦点顺序；若增加模型操作，提供可聚焦控件。",
      "reducedMotion": "保留按画幅重新构图，关闭持续旋转与着色器时间推进，并提供静止场景及可键盘操作的暂停控制；这是实施建议，来源未实现完整静止与暂停。"
    },
    "parameters": [
      {
        "name": "宽高比计算",
        "value": "hero.clientWidth / hero.clientHeight",
        "note": "来自来源源码：reposeHero() 读取首屏容器尺寸。"
      },
      {
        "name": "超宽画幅",
        "value": "宽高比 > 1.9；位置 [1.15, 0.30, 0]；缩放 0.68",
        "note": "来自来源源码：位置为场景坐标，缩放使用 setScalar。"
      },
      {
        "name": "标准横屏",
        "value": "1.4 < 宽高比 <= 1.9；位置 [0.85, 0.30, 0]；缩放 0.58",
        "note": "来自来源源码：位置为场景坐标，缩放使用 setScalar。"
      },
      {
        "name": "窄横屏",
        "value": "1.0 < 宽高比 <= 1.4；位置 [0.55, 0.45, 0]；缩放 0.48",
        "note": "来自来源源码：位置为场景坐标，缩放使用 setScalar。"
      },
      {
        "name": "较宽竖屏",
        "value": "0.7 < 宽高比 <= 1.0；位置 [0.20, 0.80, 0]；缩放 0.45",
        "note": "来自来源源码：位置为场景坐标，缩放使用 setScalar。"
      },
      {
        "name": "窄竖屏",
        "value": "宽高比 <= 0.7；位置 [0.0, 0.95, 0]；缩放 0.42",
        "note": "来自来源源码：位置为场景坐标，缩放使用 setScalar。"
      }
    ],
    "prompt": "为【目标首屏】实现「三维主角随画幅重新构图」。首次布局与容器尺寸改变时读取容器宽高比，以五档位置与等比缩放调整同一三维主角：大于 1.9、大于 1.4、大于 1.0、大于 0.7 及其余画幅分别使用来源参数作为构图参考，并根据目标模型与相机校准。横屏将主角安排在右侧，竖屏缩小并上移，为左下标题与行动留白；大气层与主角同步变换。标题、说明和行动保留为语义内容，装饰画布不进入键盘焦点顺序。减少动态时保留响应式构图，停止旋转与着色器时间推进并提供暂停控制；来源没有实现完整静止和用户暂停，这些是实施建议。可见性机制另行管理渲染生命周期。",
    "sources": [
      {
        "caseId": "stellar-museum",
        "locator": "entries/cases/stellar-museum.json#interaction/6",
        "observation": "首屏首次布局及容器尺寸改变：reposeHero() 按容器宽高比分五档设置同一星球的位置与缩放；宽高比大于 1.9 时为 [1.15, 0.30, 0]／0.68，大于 1.4 至 1.9 时为 [0.85, 0.30, 0]／0.58，大于 1.0 至 1.4 时为 [0.55, 0.45, 0]／0.48，大于 0.7 至 1.0 时为 [0.20, 0.80, 0]／0.45，其余为 [0.0, 0.95, 0]／0.42；大气层同步位置和比例，使横屏主角偏右、竖屏主角上移，为左下标题留白。",
        "evidence": "observed",
        "referenceUrl": "https://github.com/ConardLi/garden-skills/blob/2b9a89340b70f632d31c0f1c69fce94a7912423e/demo/web-design-demo/demo1-with-skill.html",
        "capturedAt": "2026-10-27"
      }
    ],
